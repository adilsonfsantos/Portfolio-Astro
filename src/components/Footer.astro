---
import "@assets/css/layout/_footer.scss";
import { SITE_AUTHOR_EMAIL, SITE_TITLE, social } from "../consts";

const today = new Date().getFullYear();

import { encodeEmail } from "../utils/encodeEmail";
---

<footer class="footer noise">
	<div class="footer__gradient"></div>
	<div class="footer__container">
		<div class="footer__content">
			<p class="footer__copyright">
				&copy;2019 &ndash; {today}&nbsp
				{SITE_TITLE}
				<br />
				Todos os direitos reservados.
			</p>
			<div class="footer__spacer"></div>
			<ul class="footer__social">
				<li>
					<a href={`mailto:${encodeEmail(SITE_AUTHOR_EMAIL)}`}>Email</a>
				</li>
				{social.links.map((link) => (
					<li>
						<a href={link.url} rel="noopener" target="_blank">
							{link.name}
						</a>
					</li>
				))}
				<li>
					<a href="/uses/" data-astro-prefetch>
						Uses
					</a>
				</li>
			</ul>
		</div>
	</div>
</footer>
