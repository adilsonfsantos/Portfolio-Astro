---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type ImageType = "card" | "banner" | "default" | "popout" | "full-width";

interface ImageProps {
	src: ImageMetadata;
	alt: string;
	type?: ImageType;
	priority?: boolean;
}

const {
	src,
	alt,
	type = "default",
	priority = false,
} = Astro.props as ImageProps;

// WCAG: alt is required only for informative images
if (alt === undefined) {
	throw new Error(`Missing alt on image: ${src.src}`);
}

if (alt !== "" && !alt.endsWith(".")) {
	throw new Error(`Image alt must end with a period: ${src.src}`);
}

if (alt.length > 150) {
	throw new Error(`Image alt exceeds 150 characters: ${src.src}`);
}

const loading = priority ? "eager" : "lazy";
const decoding = priority ? "sync" : "async";
const fetch = priority ? "high" : undefined;

interface ResponsiveConfig {
	layout?: string;
	sizes: string;
	widths: number[];
}

const responsiveConfig: Record<ImageType, ResponsiveConfig> = {
	card: {
		sizes:
			"auto, (max-width: 551px) calc(100vw - 2 * clamp(16px, calc(10.476px + 2.381vw), 40px)), (max-width: 1239px) calc((100vw - 3 * clamp(16px, calc(10.476px + 2.381vw), 40px)) / 2), 560px",
		widths: [320, 480, 640, 768, 960, 1080],
	},
	banner: {
		sizes:
			"(min-width: 1px) calc(100vw - 2 * clamp(16px, calc(10.476px + 2.381vw), 40px)), (min-width: 1272px) 1160px",
		widths: [320, 600, 880, 1160, 1540, 1920],
	},
	default: {
		sizes:
			"auto, (min-width: 1px) calc(100vw - 2 * clamp(16px, calc(10.476px + 2.381vw), 40px)), (min-width: 800px) 60ch",
		widths: [320, 600, 880, 1160, 1540, 1920],
	},
	popout: {
		layout: "popout",
		sizes:
			"auto, calc(100vw - 2 * clamp(16px, calc(10.476px + 2.381vw), 40px)), (min-width: 800px) calc(60ch + 2 * clamp(48px, calc(45.238px + 1.1905vw), 60px)), (min-width: 1272px) calc(60ch + 120px)",
		widths: [320, 600, 880, 1160, 1540, 1920],
	},
	"full-width": {
		layout: "full-width",
		sizes:
			"auto, calc(100vw - 2 * clamp(16px, calc(10.476px + 2.381vw), 40px)), (min-width: 1272px) 1160px",
		widths: [320, 600, 880, 1160, 1540, 1920],
	},
};

const { layout, sizes, widths } = responsiveConfig[type];
---

<Image
	src={src}
	alt={alt}
	fetchpriority={fetch}
	loading={loading}
	decoding={decoding}
	sizes={sizes}
	widths={widths}
	format={"avif"}
	class={layout}
/>
