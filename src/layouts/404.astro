---
import "@assets/css/abstracts/_mixins.scss";
import "@assets/css/abstracts/_variables.scss";
import "@assets/css/base/_reset.scss";
import "@assets/css/base/_typography.scss";
import "@assets/css/base/_base.scss";
import "@assets/css/components/_btn.scss";
import "@assets/css/layout/_header.scss";
import "@assets/css/layout/_hero.scss";
import "@assets/css/layout/_footer.scss";
import "@assets/css/pages/_not-found.scss";
import Default from "./Default.astro";
import { SITE_DESCRIPTION } from "../consts";

interface NotFoundFrontmatter {
	title: string;
	image?: string;
}

const { title, image } = Astro.props as NotFoundFrontmatter;
---

<Default title={title} description={SITE_DESCRIPTION} image={image}>
	<div class="noise"></div>
	<main id="main">
		<section class="hero hero--not-found">
			<div class="hero__bg"></div>
			<div class="hero__content">
				<h1 class="hero__title">
					Desculpe, a página que você está procurando não existe.
				</h1>
				<a role="button" href="/" class="btn--primary">
					Voltar para a home
				</a>
			</div>
		</section>
	</main>
</Default>
