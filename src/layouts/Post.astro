---
import "@assets/css/layout/_hero.scss";
import "@assets/css/pages/_post.scss";
import "@assets/css/components/_post_nav.scss";

import Picture from "@components/Image.astro";

interface TeamMember {
	name: string;
	role: string;
	portfolio?: string;
}

interface PostProps {
	title: string;
	image: string;
	roles: string[];
	date: Date;
	team?: TeamMember[];
}

const { title, image, roles, date, team } = Astro.props as PostProps;
---

<main id="main">
	<div class="hero__bg"></div>
	<article class="post" itemscope itemtype="http://schema.org/BlogPosting">
		<div class="post__header">
			<h1 class="post__title" itemprop="name headline">
				{title}
			</h1>
			<div class="post__info">
				<div class="post__info__container">
					<p class="post__info__title">Minha Função</p>
					{roles.map((role) => (
						<p class="post__info__text">{role}</p>
					))}
				</div>
				{team && (
					<div class="post__info__container">
						<p class="post__info__title">Equipe</p>
						{team.map((member) => (
							<p class="post__info__text">
								{member.portfolio ? (
									<a
										href={member.portfolio}
										rel="noopener noreferrer"
										target="_blank">
										{member.name}, {member.role}
									</a>
								) : (
									<>
										{member.name}, {member.role}
									</>
								)}
							</p>
						))}
					</div>
				)}
				<div class="post__info__container">
					<p class="post__info__title">Data</p>
					<p class="post__info__text">{date.getFullYear()}</p>
				</div>
			</div>
			<Picture src={image} alt="" type="banner" priority />
		</div>
		<div class="post__content" itemprop="articleBody">
			<slot />
		</div>
	</article>
</main>
