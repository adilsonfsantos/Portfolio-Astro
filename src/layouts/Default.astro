---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Meta from "@components/Meta.astro";
import { SITE_LANG } from "../consts";
import type { ImageMetadata } from "astro";

interface DefaultLayoutProps {
	title: string;
	description: string;
	image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props as DefaultLayoutProps;
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<meta charset="UTF-8" />
		<link
			rel="preload"
			as="font"
			href="/assets/fonts/InterVariable.woff2"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			as="image"
			href="/assets/images/noise.svg"
			type="image/webp"
		/>
		<style is:global is:inline>
			.noise {
				position: relative;
				overflow: hidden;
			}
			.noise::before {
				content: "";
				background-image: url("/assets/images/noise.svg");
				background-repeat: repeat;
				background-size: 400px 400px;
				pointer-events: none;
				position: absolute;
				inset: 0;
				z-index: -1;
			}
		</style>
		<Meta title={title} description={description} image={image} />
	</head>
	<body>
		<a class="skip-to-content-link btn--primary" href="#main">
			Pular para o conteúdo
		</a>
		<Header />
		{/* Bypass Facebook tracking:
			https://krausefx.com/blog/ios-privacy-instagram-and-facebook-can-track-anything-you-do-on-any-website-in-their-in-app-browser#how-to-protect-yourself-as-a-user */}
		<span id="iab-pcm-sdk"></span>
		<span id="iab-autofill-sdk"></span>
		<div class="wrapper noise">
			<slot />
			<Footer />
		</div>
	</body>
</html>
