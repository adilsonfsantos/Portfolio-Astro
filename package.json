{
	"name": "portfolio-astro",
	"description": "Portfolio of Adilson Santos using Astro",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=24 <25"
	},
	"private": true,
	"browserslist": [
		"baseline newly available with downstream"
	],
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"typecheck": "astro check",
		"eslint": "eslint . --cache --cache-location .cache/eslint",
		"eslint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
		"stylelint": "stylelint 'src/**/*.{css,scss}' --cache --cache-location .cache/stylelint",
		"stylelint:fix": "stylelint 'src/**/*.{css,scss}' --cache --cache-location .cache/stylelint --fix",
		"format": "prettier --check . --cache --cache-location .cache/prettier",
		"format:fix": "prettier --write . --cache --cache-location .cache/prettier",
		"check": "npm run typecheck && npm run eslint && npm run stylelint && npm run format",
		"ci": "npm run check && npm run build",
		"csp": "node scripts/generate-csp-hashes.ts",
		"prepare": "husky",
		"knip": "knip"
	},
	"lint-staged": {
		"*.{js,ts,astro,mdx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{scss,css}": [
			"stylelint --fix",
			"prettier --write"
		],
		"*.astro": [
			"node scripts/generate-csp-hashes.ts"
		]
	},
	"dependencies": {
		"@astrojs/mdx": "^8.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.3.5",
		"astro-compressor": "^2.0.1",
		"sass": "^1.105.1",
		"satteri-external-links": "^0.1.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/ts-plugin": "^1.10.12",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.4",
		"browserslist": "^4.29.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-mdx": "^3.8.1",
		"husky": "^9.1.7",
		"knip": "^6.39.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
		"stylelint": "^17.15.0",
		"stylelint-browser-compat": "^1.0.0-beta.199",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.3.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0"
	}
}
