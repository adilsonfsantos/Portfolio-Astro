{
	"name": "portfolio-astro",
	"description": "Portfolio of Adilson Santos using Astro",
	"type": "module",
	"version": "3.4.0",
	"engines": {
		"node": "^24 || ^26"
	},
	"private": true,
	"browserslist": [
		"baseline newly available with downstream"
	],
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"typecheck": "astro check",
		"eslint": "eslint . --cache --cache-location .cache/eslint",
		"eslint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
		"stylelint": "stylelint 'src/**/*.{css,scss}' --cache --cache-location .cache/stylelint",
		"stylelint:fix": "stylelint 'src/**/*.{css,scss}' --cache --cache-location .cache/stylelint --fix",
		"format": "prettier --check . --cache --cache-location .cache/prettier",
		"format:fix": "prettier --write . --cache --cache-location .cache/prettier",
		"lint": "npm run typecheck && npm run eslint && npm run stylelint && npm run format",
		"ci": "npm run lint && npm run build",
		"csp": "node scripts/generate-csp-hashes.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,astro,mdx}": [
			"npm run typecheck",
			"npm run eslint"
		],
		"*.{scss,css}": "npm run stylelint",
		"*.{astro,js,ts,json,mdx,scss,css}": "npm run format",
		"*.{astro,scss,css}": "npm run csp"
	},
	"dependencies": {
		"@astrojs/mdx": "^8.1.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.4.7",
		"astro-compressor": "^2.0.1",
		"sass": "^1.108.0",
		"sass-embedded": "^1.108.2",
		"satteri-external-links": "^0.1.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/ts-plugin": "^1.10.12",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"browserslist": "^4.29.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-mdx": "^3.8.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"stylelint": "^17.16.0",
		"stylelint-browser-compat": "^1.0.0-beta.180",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.4.0",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	}
}
